{
  "name": "helpers_mongodb",
  "version": "0.0.3",
  "description": "MongoDB client",
  "license": "ISC",
  "author": "",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "rm -rf dist && npm run build:cjs && npm run build:esm",
    "build:cjs": "esbuild src/index.js --bundle --packages=external --sourcemap --minify --platform=node --format=cjs --outfile=dist/index.cjs",
    "build:esm": "esbuild src/index.js --bundle --packages=external --sourcemap --minify --platform=node --format=esm --outfile=dist/index.js",
    "dev": "node src/dev.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "helpers_jsonld": "github:tactik8/helpers_jsonld",
    "jest": "^30.5.1",
    "mongodb": "^7.2.0"
  }
}
