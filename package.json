{
  "name": "mongodb_helpers",
  "version": "0.0.1",
  "description": "MongoDB client",
  "license": "ISC",
  "author": "",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "rm -rf dist && npm run build:cjs && npm run build:esm",
    "build:cjs": "npx esbuild src/index.js --bundle --minify --platform=node --packages=external --format=cjs --outfile=dist/index.cjs",
    "build:esm": "npx esbuild src/index.js --bundle --minify --platform=node --packages=external --format=esm --outfile=dist/index.js",
    "dev": "node src/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "jsonld_helpers": "github:tactik8/jsonldHelpers_v1",
    "mongodb": "^7.2.0"
  }
}
